<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia este archivo como Web.config en la raiz del sitio de IIS y ajusta
  la cadena de conexion. NO subas Web.config con credenciales reales a git
  (ya esta cubierto por .gitignore, igual que config.json).

  Dos formas de conectar a SQL Server:

  1) Autenticacion de Windows (recomendado): que el App Pool corra con una
     cuenta de dominio con permisos en SQL Server (GRANT EXECUTE sobre los
     procedimientos usp_Dash_*Multi), y deja Integrated Security=True.
     Asi no hay ninguna contraseña que proteger en este archivo.

  2) Autenticacion SQL: reemplaza Integrated Security=True por
     User ID=...;Password=... Si usas esta opcion, considera cifrar la
     seccion connectionStrings con:
       %windir%\Microsoft.NET\Framework64\v4.0.30319\aspnet_regiis.exe -pef "connectionStrings" "C:\ruta\del\sitio"
-->
<configuration>
  <connectionStrings>
    <add name="TicketsProactivanet"
         connectionString="Server=AZAUDITPRECIOS;Database=Tickets_Proactivanet;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connection Timeout=60"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <add value="dashboard.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
